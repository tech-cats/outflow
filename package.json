{
  "name": "outflow",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/plugins.mjs",
    "plugins": "node scripts/plugins.mjs",
    "dev": "node scripts/plugins.mjs && pnpm -r --parallel dev",
    "build": "node scripts/plugins.mjs && pnpm --filter web build",
    "dev:cf": "pnpm build && pnpm --filter server dev:cf",
    "start": "pnpm --filter server start",
    "setup:cf": "node scripts/setup-cf.mjs",
    "deploy:cf": "pnpm build && pnpm --filter server deploy:cf",
    "typecheck": "node scripts/plugins.mjs && pnpm -r typecheck",
    "smoke": "node scripts/smoke.mjs",
    "wrangler": "pnpm --filter server exec wrangler"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.0"
}
