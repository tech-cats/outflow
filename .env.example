# ===== 必填 =====
# 至少 16 个字符的随机字符串：openssl rand -hex 32
SESSION_SECRET=

# ===== 站点 =====
APP_NAME=Outflow
# 对外访问地址（https 时会自动启用 Secure Cookie）
APP_URL=http://localhost:8787
PORT=8787
# 部署在 Nginx/Caddy 等反向代理之后时设为 true
TRUST_PROXY=false
# 数据目录（SQLite 与上传文件）
DATA_DIR=./data

# ===== 注册白名单（默认拒绝） =====
# 逗号分隔：*.edu.cn（任意子域）、@pku.edu.cn（精确域名）、someone@gmail.com（单个邮箱）
# 管理后台还可以动态追加规则
ALLOWED_EMAIL_DOMAINS=*.edu.cn
REGISTRATION_ENABLED=true

# ===== 人机验证 =====
# altcha（自托管 PoW，默认）| turnstile | hcaptcha | none（仅开发）
CAPTCHA_PROVIDER=altcha
# turnstile/hcaptcha 的 site key 与 secret；altcha 的 secret 可留空（自动从 SESSION_SECRET 派生）
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# ===== 邮件 =====
# smtp | resend | console（只打印到日志，开发用）
MAIL_DRIVER=console
MAIL_FROM=Outflow <noreply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

MAX_UPLOAD_MB=10
