# ===== 必填 =====
# 至少 16 个字符的随机字符串：openssl rand -hex 32
SESSION_SECRET=

# ===== 站点 =====
APP_NAME=Outflow
# 对外访问地址（https 时会自动启用 Secure Cookie）
APP_URL=http://localhost:8787
PORT=8787
# 部署在 Nginx/Caddy 等反向代理之后时设为 true
TRUST_PROXY=false
# 数据目录（SQLite 与上传文件）
DATA_DIR=./data

# ===== 注册白名单（默认拒绝） =====
# 逗号分隔：*.edu.cn（任意子域）、@pku.edu.cn（精确域名）、someone@gmail.com（单个邮箱）
# 管理后台还可以动态追加规则
ALLOWED_EMAIL_DOMAINS=*.edu.cn
REGISTRATION_ENABLED=true

# ===== 人机验证 =====
# altcha（自托管 PoW，默认）| turnstile | hcaptcha | none（仅开发）
CAPTCHA_PROVIDER=altcha
# 登录验证：always（每次都要）| after_failures（连续失败 3 次后才要）
LOGIN_CAPTCHA=always
# turnstile/hcaptcha 的 site key 与 secret；altcha 的 secret 可留空（自动从 SESSION_SECRET 派生）
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# ===== 地域白名单（防滥用） =====
# 各范围允许的国家/地区（ISO 两位代码，逗号分隔），留空 = 不限制；管理后台「地域限制」可覆盖
GEO_REGISTER_COUNTRIES=CN,HK
GEO_LOGIN_COUNTRIES=
# 无法识别地区时：deny（默认）| allow
GEO_UNKNOWN=deny
# 地区来源（仅自托管；Cloudflare 自动识别，无需配置），二选一：
#  1) 信任上游代理传来的国家头，例如套了 Cloudflare 代理时用 CF-IPCountry。
#     只有在代理会覆盖该头时才能设置，否则客户端可以伪造
GEO_COUNTRY_HEADER=
#  2) 本地 IP 库：node scripts/geoip-download.mjs 下载 DB-IP Lite（每月更新）
GEO_MMDB_PATH=

# ===== 邮件 =====
# 留空自动选择：配置了 SMTP_HOST 用 smtp，配置了 RESEND_API_KEY 用 resend，都没有则无法发送验证码
# console 只把邮件打印到日志（仅限开发，必须显式设置）
MAIL_DRIVER=
MAIL_FROM=Outflow <noreply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

MAX_UPLOAD_MB=10

# 限流（每个 IP / 用户每分钟次数）；校园网共用出口 IP 时可适当调高 RATE_LIMIT_AUTH
# Cloudflare 部署请修改 server/wrangler.toml 中的 [[ratelimits]]
RATE_LIMIT_AUTH=10
RATE_LIMIT_WRITE=120
RATE_LIMIT_READ=300
